<Window x:Class="Practica1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica1"
        mc:Ignorable="d"
        Title="Portal de Videojuegos" Height="550" Width="950"
        Background="#0F0F13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CABECERA SUPERIOR -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#16161B">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,35,0" Cursor="Hand">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;" Foreground="#00E5FF" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="TIENDA" Foreground="#00E5FF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,35,0" Cursor="Hand">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" Foreground="#888888" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="COMUNIDAD" Foreground="#888888" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Cursor="Hand">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" Foreground="#888888" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SOPORTE" Foreground="#888888" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Perfil y Cerrar Sesión -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0">
                <TextBlock x:Name="txtNombreUsuario" Text="Nicolas" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Border Width="38" Height="38" CornerRadius="19" Background="#2A2A35" Margin="0,0,15,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Foreground="#00E5FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Botón de Cerrar Sesión -->
                <Button x:Name="btnCerrarSesion" Content="Cerrar Sesión" Background="Transparent" Foreground="#FF4C4C" BorderThickness="0" Cursor="Hand" Click="BtnCerrarSesion_Click" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- MENÚ LATERAL IZQUIERDO -->
        <Border Background="#16161B" Grid.Row="1" CornerRadius="12" Margin="20" Padding="0,20,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="25,15,20,15" Cursor="Hand">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE734;" Foreground="#00E5FF" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Destacados" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="25,15,20,15" Cursor="Hand">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE909;" Foreground="#888888" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Mis juegos" Foreground="#888888" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="25,15,20,15" Cursor="Hand">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="#888888" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Configuración" Foreground="#888888" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ZONA CENTRAL DE JUEGOS -->
        <Border Background="#16161B" Grid.Column="1" Grid.Row="1" Margin="0,20,20,20" CornerRadius="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Carátula Juego 1 (Valorant) -->
                <Border BorderBrush="#00E5FF" BorderThickness="2" Width="250" Height="350" Margin="30" CornerRadius="8" Cursor="Hand">
                    <Border.Background>
                        <ImageBrush ImageSource="https://i.pinimg.com/736x/79/aa/f7/79aaf76e647b1eac1329b41a661ab60d.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- Carátula Juego 2 (Fortnite) -->
                <Border BorderBrush="#00E5FF" BorderThickness="2" Width="250" Height="350" Margin="30" CornerRadius="8" Cursor="Hand">
                    <Border.Background>
                        <ImageBrush ImageSource="https://i.3djuegos.com/juegos/8298/fortnite/fotos/ficha/fortnite-5154590.webp" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- Carátula Juego 3 (Minecraft) -->
                <Border BorderBrush="#00E5FF" BorderThickness="2" Width="250" Height="350" Margin="30" CornerRadius="8" Cursor="Hand">
                    <Border.Background>
                        <ImageBrush ImageSource="https://i.pinimg.com/474x/60/ef/d6/60efd693d20f8dcedf16e91d6a69ad4a.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>